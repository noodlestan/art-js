{
  "name": "@art-js/records",
  "version": "0.2.0",
  "description": "Record identity, discovery, extraction, update and serialisation for Markdown documents.",
  "keywords": [
    "library",
    "records",
    "art",
    "markdown",
    "ast"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-js.git",
    "directory": "libs/records"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run --dir tests",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@art-md/constructs": "0.0.7",
    "@art-md/primitives": "0.0.7"
  },
  "devDependencies": {
    "@art-md/codec": "0.0.5",
    "vitest": "5.0.5"
  }
}
