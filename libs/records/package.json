{
  "name": "@art-js/records",
  "version": "0.0.1",
  "description": "Record identity, discovery, extraction, update and serialisation for Markdown documents.",
  "keywords": [
    "library",
    "records",
    "art",
    "markdown",
    "ast"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-js",
    "directory": "libs/records/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "src",
    "LICENSE-MIT"
  ],
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run --coverage --dir src",
    "test:integration": "vitest run --coverage --dir tests",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@art-md/constructs": "0.0.5",
    "@art-md/primitives": "0.0.5"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
