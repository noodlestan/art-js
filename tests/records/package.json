{
  "name": "@art-js/test-records",
  "version": "0.0.1",
  "description": "Integration tests for the record API through the codec and the FS records adapter.",
  "keywords": [
    "cli",
    "records",
    "testing",
    "art",
    "markdown",
    "ast"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/art-js.git",
    "directory": "tests/records"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts",
    "fixtures",
    "LICENSE-MIT",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "esbuild-cli-watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "esbuild-cli",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:script": "npx tsx scripts/test-records.ts",
    "test:integration": "vitest run",
    "test:ci": "npm run test:script && npm run test:integration",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@art-js/records": "*",
    "@art-lib/fs-records": "0.0.3",
    "@art-md/codec": "0.0.3",
    "@art-md/primitives": "0.0.6"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
